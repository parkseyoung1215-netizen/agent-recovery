{
  "_설명": "n8n이 요청을 보내는 주소(match)마다, 그 요청이 '이미 처리됐는지' 확인하는 방법을 적어요. {id}는 항목의 식별값(id_field)으로 바뀌고, ${이름}은 .env 파일이나 환경변수 값으로 바뀌어요(비밀값은 여기 적지 말 것). lookup_mode: strong = 기록이 바로 조회됨, eventual = 늦게 반영될 수 있음(settle_seconds 동안은 '없음'을 믿지 않음). 진짜 서비스를 붙일 때는 이 목록에 한 줄 추가하면 돼요. 가짜 쇼핑몰은 기록이 바로 조회돼서 strong으로 둠(단, /scenario/7은 일부러 8초 늦게 반영되는 상황이라 그 실험에서는 eventual이 맞음). 진짜 서비스는 확실하지 않으면 eventual로 두세요.",
  "services": [
    {
      "name": "가짜 쇼핑몰 - 결제",
      "match": "http://127.0.0.1:8000/pay",
      "id_field": "order_id",
      "lookup": "http://127.0.0.1:8000/check/pay?order_id={id}",
      "exists": "exists",
      "lookup_mode": "strong",
      "settle_seconds": 30
    },
    {
      "name": "가짜 쇼핑몰 - 재고",
      "match": "http://127.0.0.1:8000/inventory",
      "id_field": "order_id",
      "lookup": "http://127.0.0.1:8000/check/inventory?order_id={id}",
      "exists": "exists",
      "lookup_mode": "strong",
      "settle_seconds": 30
    },
    {
      "name": "가짜 쇼핑몰 - 배송",
      "match": "http://127.0.0.1:8000/ship",
      "id_field": "order_id",
      "lookup": "http://127.0.0.1:8000/check/ship?order_id={id}",
      "exists": "exists",
      "lookup_mode": "strong",
      "settle_seconds": 30
    },
    {
      "name": "가짜 메일 서비스",
      "match": "http://127.0.0.1:8000/email",
      "id_field": "to",
      "lookup": "http://127.0.0.1:8000/check/email?to={id}",
      "exists": "exists",
      "lookup_mode": "strong",
      "settle_seconds": 30
    },
    {
      "name": "Google Sheets (Apps Script 웹 앱, 실험 9)",
      "_메모": "주소는 .env의 SHEETS_URL에서 읽음. 스크립트가 잠금을 잡고 기록한 뒤 flush하고, 조회도 같은 시트를 바로 읽어서 strong으로 둠",
      "match": "${SHEETS_URL}",
      "id_field": "order_id",
      "lookup": "${SHEETS_URL}?order_id={id}",
      "exists": "found",
      "lookup_mode": "strong",
      "settle_seconds": 30
    }
  ]
}
